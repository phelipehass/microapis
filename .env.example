# Domínio que aponta para o VPS. O Caddy emite o certificado para ele.
DOMAIN=api.seudominio.com.br

# Obrigatório em produção. Copie de: RapidAPI > seu app > Settings >
# "Secret" na seção RapidAPI Proxy Secret. Sem isso, quem descobrir o IP do
# servidor usa a API fora do medidor de cobrança.
RAPIDAPI_PROXY_SECRET=cole-o-segredo-do-rapidapi-aqui

APP_ENV=production
PORT=8080

# Limites da busca da página alvo.
FETCH_TIMEOUT=15s
FETCH_MAX_BYTES=5242880
FETCH_MAX_REDIRECTS=5

# Teto do request inteiro, sempre maior que FETCH_TIMEOUT.
REQUEST_TIMEOUT=25s

# Proteção de infra por assinante. A cota comercial quem mede é o RapidAPI.
RATE_LIMIT_PER_MINUTE=120
